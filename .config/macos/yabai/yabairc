#!/usr/bin/env sh
#
# yabai —— macOS x86_64（黑苹果）首选窗口管理器。
# 白苹果（Apple Silicon / 官方硬件）首选 AeroSpace，见 ../aerospace/；
# 两者都用 alt 作 Mod，不要同机同跑。安装、升级、SA 与权限步骤见同目录 README.md。
#
# yabai 会自动读取 $XDG_CONFIG_HOME/yabai/yabairc（本仓库部署到
# ~/.config/yabai/yabairc），因此不需要再放一份 ~/.yabairc。

# ---------------------------------------------------------------------------
# Scripting addition（SA）
# ---------------------------------------------------------------------------
# 移动/创建/销毁空间、窗口阴影、sticky/pip/scratchpad 等依赖 SA。
# 需要 /private/etc/sudoers.d/yabai 的免密条目（见 README.md），
# 否则这一行会卡在密码提示上，launchd 服务起不来。
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# ---------------------------------------------------------------------------
# 全局配置（留白/间隙与 AeroSpace 的 gaps 5 对齐）
# ---------------------------------------------------------------------------
yabai -m config                                 \
    layout                       bsp            \
    window_gap                   5              \
    top_padding                  5              \
    bottom_padding               5              \
    left_padding                 5              \
    right_padding                5              \
    split_ratio                  0.50           \
    split_type                   auto           \
    auto_balance                 off            \
    window_placement             second_child   \
    window_insertion_point       focused        \
    window_zoom_persist          on             \
    window_shadow                on             \
    skip_window_focus_animation  on             \
    window_animation_duration    0.0            \
    window_opacity_duration      0.0            \
    window_opacity               off            \
    active_window_opacity        1.0            \
    normal_window_opacity        1.0            \
    mouse_follows_focus          off            \
    focus_follows_mouse          off            \
    insert_feedback_color        0xff89b4fa     \
    mouse_modifier               fn             \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap

# ---------------------------------------------------------------------------
# 浮动窗口规则（对齐 AeroSpace 的 on-window-detected）
# ---------------------------------------------------------------------------
# 注意：`app=` 匹配的是**本地化应用名**（yabai 取的是进程名 `CopyProcessName`，本机
# AppleLocale=zh_CN 下即本地化名）。实测 Finder 报「访达」、Spotlight 报「聚焦」、微信报
# 「微信」、系统设置报「系统设置」，只写英文名会**静默不匹配**（无报错，就是不生效），所以
# 这里统一用中英并列的 alternation；但也有反例：QQ 的显示名就是纯英文（mdls 实测），直接写
# ^QQ$ 即可。yabai 的规则不支持 bundle-id；离线核对本地化名的办法是
# `mdls -name kMDItemDisplayName -raw /Applications/Foo.app`，在线核对用
# `yabai -m query --windows | grep -o '"app":"[^"]*"' | sort -u`（详见 README「窗口层级」）。
# 规则一旦失效，窗口会被当成普通窗口平铺托管 → 被压到 below 子层，症状就是「打开也总在后面」。
yabai -m rule --add app="^(Finder|访达)$"                                              manage=off
yabai -m rule --add app="^(WeChat|微信)$"                                              manage=off
yabai -m rule --add app="^QQ$"                                                         manage=off
yabai -m rule --add app="^(System Settings|System Preferences|系统设置|系统偏好设置)$" manage=off
yabai -m rule --add app="^(Spotlight|聚焦)$"                                           manage=off
yabai -m rule --add title="Picture-in-Picture|画中画"                                  manage=off

# ---------------------------------------------------------------------------
# 空间：只有按 mission-control index 寻址的 1..5（不打任何标签）
# ---------------------------------------------------------------------------
# 只用数字工作区，所以不需要 yabai 的 label；而且 yabai **不允许纯数字标签**
# （`space --label 1` → `'1' cannot be used as a label.`：label 必须是字符串 token，
# 否则会与 mission-control index 在 `SPACE_SEL` 里撞车），数字工作区用 index 寻址本来
# 就够用。顺序稳定性靠 defaults.sh 里的 `mru-spaces=false` 保证。
#
# 幂等：先把空间数补到 5。`space --create` 不会把焦点移到新空间、且 `query --spaces`
# 不一定马上反映新建结果，所以用本地计数推进（避免多建一个），create 返回非 0 就停手。
# 依赖 SIP 部分关闭（本机黑苹果由 OpenCore 关闭）且 SA 已加载；失败时静默跳过。
ensure_spaces() {
    _count=$(yabai -m query --spaces 2>/dev/null | grep -c '"index"')

    while [ "${_count:-0}" -lt 5 ]; do
        yabai -m space --create >/dev/null 2>&1 || break
        _count=$((_count + 1))
    done
}

ensure_spaces

# 补充浮动规则（2026-10-01 用户选定）：工具类应用 + 通用对话框兜底。
# 这四个应用无本地化名（kMDItemDisplayName 均为英文），直接用英文名匹配；
# subrole=AXDialog 让所有应用的模态对话框浮动（确认框/警告框不被平铺）。
# 必须注册在下方 `rule --apply` 之前，才能在启动时一并回放到已开窗口。
yabai -m rule --add app="^Clash Verge$"           manage=off
yabai -m rule --add app="^Karabiner-Elements$"    manage=off
yabai -m rule --add app="^Karabiner-EventViewer$" manage=off
yabai -m rule --add app="^OCLP-Mod$"              manage=off
yabai -m rule --add subrole="AXDialog"            manage=off

# yabai 的规则只对**规则注册之后新出现**的窗口生效，已开着的窗口不会自动归位。
# 启动时把现有规则回放到当前窗口，登录/重启后 Finder / 微信 / 系统设置直接浮动。
yabai -m rule --apply >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# 焦点边框（JankyBorders）
# ---------------------------------------------------------------------------
# yabai 6.0+ 已移除内置窗口边框，焦点反馈改由 JankyBorders 提供（其官方
# README 的 yabai 用法就是在此处启动）。颜色/宽度对齐仓库与 AeroSpace：
# 焦点 Catppuccin 蓝，非焦点透明（只高亮当前窗口），宽度 5。
# 未安装时静默跳过；重复启动是安全的（已有实例只被更新属性，不会堆积进程）。
if command -v borders >/dev/null 2>&1; then
    borders active_color=0xff89b4fa inactive_color=0x00494d64 width=5.0 &
fi

echo "yabai configuration loaded.."
