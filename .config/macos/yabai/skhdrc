# skhd —— yabai 的快捷键（macOS x86_64 / 黑苹果首选组合）
#
# 部署到 ~/.config/skhd/skhdrc；热键语义对齐 AeroSpace（../aerospace/），Mod = alt。
# 安装、权限与升级见同目录 README.md。
#
# 注意：skhd 的键位字面量只认 return/tab/space/backspace/escape/delete/方向键/
# F1-F20/媒体键；标点键必须写物理 keycode（0x..，十六进制字母要大写），
# 见下方「布局」与「调整大小」两处。
#   0x1B = kVK_ANSI_Minus，0x18 = kVK_ANSI_Equal
#   0x2C = kVK_ANSI_Slash，0x2B = kVK_ANSI_Comma

# --- 启动器 ---------------------------------------------------------------
alt - return : open -na Alacritty
alt - e      : open -a Finder

# --- 窗口 -----------------------------------------------------------------
alt - q        : yabai -m window --close
alt - f        : yabai -m window --toggle zoom-fullscreen
alt + ctrl - f : yabai -m window --toggle float
alt + ctrl - d : yabai -m window --toggle zoom-parent
alt + ctrl - b : yabai -m space --balance

# SA 专属（需要 scripting addition 已加载）
alt + ctrl - t : yabai -m window --toggle sticky
alt + ctrl - p : yabai -m window --toggle pip

# --- 布局 -----------------------------------------------------------------
alt - 0x2C : yabai -m space --layout bsp
alt - 0x2B : yabai -m space --layout stack

# --- 聚焦 -----------------------------------------------------------------
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# --- 交换位置 -------------------------------------------------------------
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# --- 调整大小 -------------------------------------------------------------
# yabai 的 handle 指的是**被拖动的 fence**（见 src/window_manager.c 的
# window_manager_resize_window_relative）：first_child（左/上）只有东/南 fence，
# second_child（右/下）只有西/北 fence，所以单个 handle 会有一半情况报
# "cannot locate a bsp node fence"（实测：占满整屏的单窗口两边都没有 fence，必报）。
# 这里按 右→左→下→上 依次尝试，等效 AeroSpace 的 `resize smart`；
# 2>/dev/null 是为了不让失败的尝试刷进 /tmp/skhd_*.err.log。
alt + shift - 0x1B : yabai -m window --resize right:-50:0 2>/dev/null \
    || yabai -m window --resize left:50:0 2>/dev/null \
    || yabai -m window --resize bottom:0:-50 2>/dev/null \
    || yabai -m window --resize top:0:50
alt + shift - 0x18 : yabai -m window --resize right:50:0 2>/dev/null \
    || yabai -m window --resize left:-50:0 2>/dev/null \
    || yabai -m window --resize bottom:0:50 2>/dev/null \
    || yabai -m window --resize top:0:-50

# --- 空间 1 / 2 / 3 / 4 / 5 ---------------------------------------------------
# 全部用 mission-control index 寻址：yabai 不允许纯数字标签
# （`space --label 1` 报 "'1' cannot be used as a label."），而数字工作区用 index
# 本来就够用，所以 yabairc 里不对空间打任何标签（靠 mru-spaces=false 保顺序稳定）。
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5

# 移动当前窗口到目标空间并跟随（对齐 AeroSpace 的 --focus-follows-window）
alt + shift - 1 : yabai -m window --space 1 && yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2 && yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3 && yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4 && yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5 && yabai -m space --focus 5

# --- 往返 / 显示器 --------------------------------------------------------
alt - tab         : yabai -m space --focus recent
alt + shift - tab : yabai -m display --focus next
