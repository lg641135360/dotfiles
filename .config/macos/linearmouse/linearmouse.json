{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.11.4",
  "schemes" : [
    {
      "buttons" : {
        "clickDebouncing" : {
          "buttons" : [
            0
          ],
          "timeout" : 0
        },
        "gesture" : {
          "actions" : {
            "down" : "appExpose",
            "left" : "missionControl.spaceLeft",
            "right" : "missionControl.spaceRight",
            "up" : "missionControl"
          },
          "enabled" : false,
          "threshold" : 50,
          "trigger" : {
            "button" : 2
          }
        },
        "universalBackForward" : true
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xa6",
          "productName" : "Razer Viper V2 Pro",
          "vendorID" : "0x1532"
        }
      },
      "pointer" : {
        "acceleration" : "unset",
        "disableAcceleration" : false,
        "redirectsToScroll" : false,
        "speed" : "unset"
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : "auto"
        },
        "reverse" : {
          "vertical" : true
        },
        "smoothed" : {
          "vertical" : {
            "enabled" : false
          }
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}