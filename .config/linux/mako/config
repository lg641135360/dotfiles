font=Maple Mono NF CN 11
background-color=#1e1e2ef2
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
border-radius=10
padding=10
margin=10
outer-margin=8
width=380
height=180
default-timeout=8000
max-visible=5
anchor=top-right
icons=1
max-icon-size=48
markup=1
actions=1
layer=overlay

[urgency=low]
border-color=#45475a
default-timeout=4000

[urgency=critical]
border-color=#f38ba8
default-timeout=0

# 免打扰模式：niri `Mod+Shift+N` 调 `makoctl mode -t do-not-disturb` 切换。
# invisible=1 隐藏普通/低优先级弹窗（通知仍进历史，makoctl history 可查）；
# critical 通知保持可见，避免错过重要告警。
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
