[Desktop Entry]
Name=Obsidian
Comment=Obsidian knowledge base (native Wayland under niri)
# Route through obsidian-wayland so the Wayland session adds
# --ozone-platform=wayland --enable-wayland-ime --disable-vulkan to the deb
# binary at /opt/Obsidian (plain exec exits without a window: Vulkan is not
# compatible with the Wayland surface factory). X11 passes through unchanged.
# __HOME__ is rewritten to the real $HOME by install.sh at deploy time so the
# entry is portable across machines/users.
Exec=__HOME__/.config/scripts/obsidian-wayland %U
Icon=obsidian
Type=Application
StartupNotify=false
StartupWMClass=md.obsidian.Obsidian
Categories=Office;
MimeType=x-scheme-handler/obsidian;
Keywords=obsidian;notes;
