// Ubuntu aarch64 laptop (MediaTek). Outputs live in ./outputs.kdl.
// Platform: ubuntu_aarch64
// Keep AwesomeWM available; this file only defines the niri session behavior.
// Common input/layout/blur/window-rule/binds live in ../common.kdl.
// MediaTek GPU scaling breaks Alacritty 0.18 glyphs; terminal-wayland prefers foot.
// Validate with: niri validate -c .config/linux/niri/ubuntu_aarch64/config.kdl

include "outputs.kdl"
include "../common.kdl"

// ---- aarch64 平台覆盖：mtgpu 驱动的 blur 无明显视觉效果，仅保留透明 ----
// 后定义的规则会覆盖 common.kdl 中同匹配的 blur true，关闭模糊。
// common.kdl 全局透明度为 88%；此处覆盖为 0.90 并关闭 blur。
window-rule {
    opacity 0.90
    background-effect {
        blur false
    }
}

// common.kdl 已定义钉钉 2/3 列宽与不透明规则；这里位于平台级全局透明
// 规则之后再次覆盖 opacity，确保 mtgpu/XWayland 下最终保持完全不透明。
window-rule {
    match app-id=r#"^com\.alibabainc\.dingtalk$"#
    opacity 1.0
}

layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur false
    }
}

layer-rule {
    match namespace="^fuzzel$"
    background-effect {
        blur false
    }
}
