// niri common config shared across platforms.
// Platform-specific files (ubuntu_x64/config.kdl, arch_x64/config.kdl) only
// declare their output sections and then `include "../common.kdl"`.
// Keep AwesomeWM available; this file only defines the niri session behavior.
// Validate with: niri validate -c ~/.config/niri/config.kdl

// Environment variables for niri and all processes it spawns. wayland-autostart
// additionally syncs these to DBus / systemd user session for compatibility.
environment {
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"
    INPUT_METHOD "fcitx"
    LC_CTYPE "zh_CN.UTF-8"
    XCURSOR_SIZE "32"
    // niri spawn 环境不设置 ZDOTDIR：否则 zsh 落到默认 ~/.zshrc 且无 .zshenv 的
    // skip_global_compinit，会跑 Ubuntu 全局 compinit（实测交互启动 4.2s vs 优化
    // 配置 0.18s）。全局设置使 Mod+Return 拉起的终端也走 ~/.config/zsh 优化配置。
    // 注意：niri 的 environment {} 不展开 ~，必须用绝对路径。
    ZDOTDIR "/home/rikoo/.config/zsh"
    // 以纯 Wayland 会话身份运行：手动从 shell 启动 niri 时这些值会继承错误的
    // 会话环境（XDG_SESSION_TYPE=tty、XDG_CURRENT_DESKTOP=awesome），导致应用
    // /toolkit 无法正确走 text-input-v3 接入 fcitx5，表现为无法输入中文。
    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    // GTK_IM_MODULE intentionally unset: Wayland GTK uses text-input protocol.
}

cursor {
    xcursor-size 32
    hide-when-typing
}

input {
    keyboard {
        xkb {
            // Leave layout to systemd-localed / GNOME settings unless overridden later.
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
        scroll-method "two-finger"
        accel-speed 0.3
        // 高分屏（aarch64 内屏 2880x1800@120 + scale 2.0）下默认 1.0 滚动偏慢，
        // 整体提速到 1.5；x86_64 桌面无触摸板时此项无副作用。
        scroll-factor 1.5
        // tap-and-drag 时短暂抬指不掉拖动，便于跨屏拖窗口/选区文本。
        drag-lock
    }

    mouse {
        accel-speed 0.0
    }

    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 12
    center-focused-column "on-overflow"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    border { off; }

    // Transparent workspace background: wallpaper shows cleanly during normal use.
    // Overview dims the wallpaper with backdrop-color and adds workspace card shadows.
    background-color "transparent"

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

spawn-sh-at-startup "~/.config/scripts/wayland-autostart"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
    window-open {
        spring damping-ratio=0.7 stiffness=700 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=0.7 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
}

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

// Overview: wallpaper stays on background layer (no place-within-backdrop).
// Use backdrop-color to dim the background for visual separation from workspace cards.
// place-within-backdrop was tested with both swaybg and awww but did not take effect
// on niri 26.04 via load-config-file; may revisit after niri update.
overview {
    backdrop-color "#1e1e2e"

    workspace-shadow {
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000060"
    }
}

layer-rule {
    match namespace="^waybar$"

    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^fuzzel$"

    background-effect {
        blur true
    }
}

window-rule {
    draw-border-with-background false
    // 全局窗口默认 0.88 透明度 + niri 背景模糊。透明叠加各应用自身透明度
    // （如 alacritty 的 background_opacity 0.82 / foot 的 colors.alpha 0.82）。
    opacity 0.88
    background-effect {
        blur true
    }
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"^CherryStudio$"#
    default-column-width { proportion 0.66667; }
}

window-rule {
    match app-id=r#"^google-chrome$"#
    default-column-width { proportion 0.66667; }
}

window-rule {
    match app-id=r#"^com\.alibabainc\.dingtalk$"#
    default-column-width { proportion 0.66667; }
    opacity 1.0
}

window-rule {
    match app-id=r#"^code$"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"^trae-cn$"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"^(org\.kde\.polkit-kde-authentication-agent-1|pinentry|ssh-askpass)$"#
    open-floating true
    opacity 1.0
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Awesome-compatible launcher muscle memory.
    Mod+Return repeat=false hotkey-overlay-title="打开终端" { spawn "~/.config/scripts/terminal-wayland"; }
    Mod+E repeat=false hotkey-overlay-title="打开文件管理器" { spawn "~/.config/scripts/file-manager-wayland"; }
    Mod+C repeat=false hotkey-overlay-title="启动应用" { spawn "~/.config/scripts/launcher-wayland"; }
    Mod+Q repeat=false hotkey-overlay-title="关闭当前窗口" { close-window; }
    Mod+Alt+L repeat=false hotkey-overlay-title="锁屏" { spawn "~/.config/scripts/lock-wayland"; }
    Mod+Shift+W repeat=false hotkey-overlay-title="切换壁纸" { spawn "~/.config/scripts/wallpaper-wayland-next"; }
    Mod+O repeat=false hotkey-overlay-title="显示总览" { toggle-overview; }
    Mod+Tab repeat=false hotkey-overlay-title="切换到上一个窗口" { focus-window-previous; }
    Mod+Shift+Q repeat=false hotkey-overlay-title="退出 niri" { quit; }

    // Adjust column width / window height without occupying the primary H/J/K/L navigation keys.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // niri-native column/window navigation. H/L focus the adjacent column, or
    // cross to the adjacent monitor when already at the first/last column.
    Mod+H { focus-column-or-monitor-left; }
    Mod+L { focus-column-or-monitor-right; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }

    Mod+A repeat=false { focus-monitor-left; }
    Mod+D repeat=false { focus-monitor-right; }
    Mod+Ctrl+Shift+A repeat=false { move-workspace-to-monitor-left; }
    Mod+Ctrl+Shift+D repeat=false { move-workspace-to-monitor-right; }
    Mod+1 repeat=false { focus-workspace 1; }
    Mod+2 repeat=false { focus-workspace 2; }
    Mod+3 repeat=false { focus-workspace 3; }
    Mod+4 repeat=false { focus-workspace 4; }
    Mod+5 repeat=false { focus-workspace 5; }
    Mod+6 repeat=false { focus-workspace 6; }
    Mod+7 repeat=false { focus-workspace 7; }
    Mod+8 repeat=false { focus-workspace 8; }
    Mod+9 repeat=false { focus-workspace 9; }
    Mod+Shift+1 repeat=false { move-window-to-workspace 1; }
    Mod+Shift+2 repeat=false { move-window-to-workspace 2; }
    Mod+Shift+3 repeat=false { move-window-to-workspace 3; }
    Mod+Shift+4 repeat=false { move-window-to-workspace 4; }
    Mod+Shift+5 repeat=false { move-window-to-workspace 5; }
    Mod+Shift+6 repeat=false { move-window-to-workspace 6; }
    Mod+Shift+7 repeat=false { move-window-to-workspace 7; }
    Mod+Shift+8 repeat=false { move-window-to-workspace 8; }
    Mod+Shift+9 repeat=false { move-window-to-workspace 9; }
    Mod+Ctrl+1 repeat=false { move-column-to-workspace 1; }
    Mod+Ctrl+2 repeat=false { move-column-to-workspace 2; }
    Mod+Ctrl+3 repeat=false { move-column-to-workspace 3; }
    Mod+Ctrl+4 repeat=false { move-column-to-workspace 4; }
    Mod+Ctrl+5 repeat=false { move-column-to-workspace 5; }
    Mod+Ctrl+6 repeat=false { move-column-to-workspace 6; }
    Mod+Ctrl+7 repeat=false { move-column-to-workspace 7; }
    Mod+Ctrl+8 repeat=false { move-column-to-workspace 8; }
    Mod+Ctrl+9 repeat=false { move-column-to-workspace 9; }

    Mod+Space repeat=false { switch-preset-column-width; }
    Mod+Shift+Space repeat=false { switch-preset-column-width-back; }
    Mod+F repeat=false { fullscreen-window; }
    Mod+M repeat=false { maximize-window-to-edges; }
    Mod+Ctrl+M repeat=false { maximize-column; }
    Mod+Ctrl+F repeat=false { expand-column-to-available-width; }
    Mod+Ctrl+C repeat=false { center-column; }
    Mod+Ctrl+Space repeat=false hotkey-overlay-title="切换窗口浮动" { toggle-window-floating; }
    Mod+Shift+V repeat=false hotkey-overlay-title="切换浮动/平铺焦点" { switch-focus-between-floating-and-tiling; }
    Mod+W repeat=false hotkey-overlay-title="切换列标签模式" { toggle-column-tabbed-display; }

    Mod+BracketLeft repeat=false hotkey-overlay-title="向左并入/移出窗口" { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false hotkey-overlay-title="向右并入/移出窗口" { consume-or-expel-window-right; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight cooldown-ms=150 { focus-column-or-monitor-right; }
    Mod+WheelScrollLeft cooldown-ms=150 { focus-column-or-monitor-left; }

    Mod+S repeat=false { spawn "~/.config/scripts/screenshot-wayland"; }
    Ctrl+Print repeat=false { screenshot-screen; }
    Alt+Print repeat=false { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+Escape repeat=false allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
