#!/bin/sh
# dms-niri-setup — 把 dotfiles 的仓库侧配置接进 DMS 自管的 niri 会话（幂等）。
#
# 背景：DMS（DankMaterialShell）接管 niri 后会重写 ~/.config/niri/config.kdl，
# 只 include 它自己的 dms/*.kdl 片段；仓库的 common.kdl、键位与
# wayland-autostart 链都不再生效。本脚本负责补回仓库侧缺的那一层。
#
# 四件幂等的事：
#   1. dms/binds.kdl 为空 → dms setup binds（部署 DMS 默认键位）
#   2. config.kdl 补上已存在但未被 include 的 dms/*.kdl 片段
#   3. include 仓库片段 niri-repo.kdl，且保证它排在所有 dms/*.kdl 之后
#      —— niri 的 binds 合并规则是「后出现的同键绑定覆盖先出现的」
#      （niri-config/src/lib.rs），顺序决定键位归谁
#   4. 通过 DMS 通道重建钉钉窗口规则（dms config windowrules add niri）
#
# 用法：
#   dms-niri-setup            应用（默认，改动前备份 config.kdl）
#   dms-niri-setup --check    只检查；有待补项时退出码 1（可用于巡检）
#   dms-niri-setup --dry-run  只打印将做的改动，不写任何文件
#
# 非 niri / 非 DMS 机器上直接退出 0（no-op），因此可以无条件调用；
# 本脚本不安装任何软件。

set -u

usage() {
    cat <<'EOF'
用法：dms-niri-setup [--check | --dry-run]

  （无参数）   应用改动（幂等）
  --check      只检查；有待补项时退出码 1
  --dry-run    只打印将做的改动，不写文件
  -h, --help   显示本帮助
EOF
}

mode=apply
while [ $# -gt 0 ]; do
    case $1 in
        --check)
            mode=check
            shift
            ;;
        --dry-run)
            mode=dry-run
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf '[dms-niri-setup] 未知参数：%s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

info() { printf '[dms-niri-setup] %s\n' "$*"; }
warn() { printf '[dms-niri-setup] 警告：%s\n' "$*" >&2; }

apply=1
[ "$mode" = apply ] || apply=0

command -v niri >/dev/null 2>&1 || {
    info "未找到 niri，跳过（非 niri 机器）"
    exit 0
}
command -v dms >/dev/null 2>&1 || {
    info "未找到 dms，跳过（非 DMS 机器）"
    exit 0
}

niri_dir=$HOME/.config/niri
config=$niri_dir/config.kdl
dms_dir=$niri_dir/dms
fragment=$niri_dir/niri-repo.kdl
own_include='include "niri-repo.kdl"'
own_comment='// dotfiles 仓库片段（必须排在 dms/*.kdl 之后）'
settings_manifest=${DMS_SETTINGS_FILE:-$HOME/.config/dms/settings.txt}

drift=0

# 读取一个设置项的当前值（settings_manifest 支持的三类键）。
read_setting() {
    case $1 in
        night.temperature)
            dms ipc call night getTargetTemp 2>/dev/null || true
            ;;
        night.enabled)
            case $(dms ipc call night status 2>/dev/null || true) in
                *"Night mode: enabled"*) printf 'true\n' ;;
                *"Night mode: disabled"*) printf 'false\n' ;;
                *) printf 'unknown\n' ;;
            esac
            ;;
        *)
            dms ipc call settings get "$1" 2>/dev/null || true
            ;;
    esac
}

# DMS 设置下发（见 .config/linux/dms/settings.txt）：幂等，读不到的键只警告不写。
# 设置下发不依赖 niri 配置是否已生成，因此放在前面执行。
apply_settings() {
    if [ ! -f "$settings_manifest" ]; then
        warn "缺 $settings_manifest（install.sh 会部署仓库的 .config/linux/dms/settings.txt）"
        return 0
    fi

    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            ''|'#'*) continue ;;
        esac
        key=${line%%=*}
        value=${line#*=}
        [ -n "$key" ] || continue

        current=$(read_setting "$key")
        if [ -z "$current" ] || [ "$current" = "unknown" ]; then
            warn "设置键不可读，跳过：$key（可能是 DMS 版本差异或非 SettingsData 键）"
            continue
        fi
        [ "$current" = "$value" ] && continue

        drift=1
        if [ "$apply" -eq 1 ]; then
            case $key in
                night.temperature)
                    dms ipc call night setTargetTemp "$value" >/dev/null 2>&1
                    ;;
                night.enabled)
                    if [ "$value" = true ]; then
                        dms ipc call night enable >/dev/null 2>&1
                    else
                        dms ipc call night disable >/dev/null 2>&1
                    fi
                    ;;
                *)
                    dms ipc call settings set "$key" "$value" >/dev/null 2>&1
                    ;;
            esac
            if [ "$(read_setting "$key")" = "$value" ]; then
                info "设置 $key：$current → $value"
            else
                warn "设置 $key 失败（仍为 $(read_setting "$key")，目标 $value）"
            fi
        else
            info "需要改动：设置 $key：$current → $value"
        fi
    done <"$settings_manifest"
}

apply_settings

[ -d "$niri_dir" ] || {
    warn "缺 $niri_dir：先在 niri 会话里启动一次 DMS 再运行本脚本"
    exit 0
}
[ -f "$config" ] || {
    warn "缺 $config：DMS 尚未生成 niri 配置，登录 niri 后再运行本脚本"
    exit 0
}

# 与 install.sh 的 clean_old_backups 对齐：同类备份保留最近 3 份。
prune_backups() {
    set -- $(ls -1t "$config".backup.* 2>/dev/null || true)
    count=0
    for old_backup in "$@"; do
        count=$((count + 1))
        [ "$count" -gt 3 ] && rm -f "$old_backup"
    done
}

backup_config() {
    backup=$config.backup.$(date +%Y%m%d_%H%M%S)_$$
    if cp -p "$config" "$backup"; then
        info "备份：$backup"
        prune_backups
    else
        warn "备份 $config 失败"
    fi
}

# 1) DMS 默认键位：binds.kdl 为空时补齐。
#    注意 `dms setup binds` 是交互式命令（会询问提权工具与终端），脚本里跑不通；
#    `dms setup headless` 才是非交互入口，但它会写/覆盖 config.kdl，所以在临时
#    HOME 里生成、只取需要的 binds.kdl（已装 alacritty 时用它作为终端，
#    否则保持 DMS 默认）。
binds_file=$dms_dir/binds.kdl
if [ ! -s "$binds_file" ]; then
    drift=1
    if [ "$apply" -eq 1 ]; then
        scratch=$(mktemp -d)
        setup_terminal=""
        command -v alacritty >/dev/null 2>&1 && setup_terminal="--terminal alacritty"
        # $setup_terminal 故意不加引号：为空时不应产生空参数。
        # shellcheck disable=SC2086
        if HOME=$scratch DMS_PRIVESC=sudo dms setup headless --compositor niri --skip-existing $setup_terminal </dev/null >/dev/null 2>&1 &&
            [ -s "$scratch/.config/niri/dms/binds.kdl" ]; then
            cp -p "$scratch/.config/niri/dms/binds.kdl" "$binds_file"
            info "部署 DMS 默认键位（scratch HOME 生成，终端：${setup_terminal:-DMS 默认}）"
        else
            warn "无法生成 DMS 默认键位；可在 DMS 设置 → Keybinds 里手动生成"
        fi
        rm -rf "$scratch"
        [ -s "$binds_file" ] || warn "$binds_file 仍为空：DMS 功能没有快捷键入口"
    else
        info "需要改动：dms/binds.kdl 为空（缺 DMS 默认键位）"
    fi
fi

# 2) 收集需要补的 dms/*.kdl include：以 dms config resolve-include 的 JSON 为准，
#    exists=true 且 included=false 才补；CLI 无输出/不认识该片段时不擅自添加。
missing=$(mktemp) || exit 1
trap 'rm -f "$missing"' EXIT INT TERM
for fragment_file in "$dms_dir"/*.kdl; do
    [ -f "$fragment_file" ] || continue
    fragment_name=${fragment_file##*/}
    resolve=$(dms config resolve-include niri "$fragment_name" 2>/dev/null || true)
    case $resolve in
        *'"included":true'*) continue ;;
        *'"exists":true'*) ;;
        *) continue ;;
    esac
    printf 'include "dms/%s"\n' "$fragment_name" >>"$missing"
done
missing_count=$(grep -c . "$missing" || true)
[ "$missing_count" -gt 0 ] && drift=1

# 3) 仓库片段必须在所有 dms/*.kdl 之后（键位覆盖关系），缺失/顺序不对时统一重写尾部。
if [ -f "$fragment" ]; then
    own_line=$(grep -nF -- "$own_include" "$config" | head -n 1 || true)
    own_line=${own_line%%:*}
    last_dms_line=$(grep -nE 'include .*"dms/[^"]+\.kdl"' "$config" | tail -n 1 || true)
    last_dms_line=${last_dms_line%%:*}

    reorder=0
    if [ -n "$own_line" ] && [ -n "$last_dms_line" ] && [ "$own_line" -lt "$last_dms_line" ]; then
        reorder=1
    fi

    if [ -z "$own_line" ] || [ "$missing_count" -gt 0 ] || [ "$reorder" -eq 1 ]; then
        drift=1
        if [ "$apply" -eq 1 ]; then
            if [ "$reorder" -eq 1 ]; then
                info "调整 include 顺序：niri-repo.kdl 移到 dms/*.kdl 之后"
            else
                info "include 仓库片段：$own_include"
            fi
            backup_config
            tmp_config=$config.tmp.$$
            # 先移除旧的仓库注释/include，再统一追加到末尾：顺序正确且天然幂等。
            grep -vF -- "$own_include" "$config" | grep -vF -- "$own_comment" >"$tmp_config" || true
            if [ "$missing_count" -gt 0 ]; then
                cat "$missing" >>"$tmp_config"
            fi
            printf '%s\n%s\n' "$own_comment" "$own_include" >>"$tmp_config"
            mv "$tmp_config" "$config"
        elif [ "$reorder" -eq 1 ]; then
            info "需要改动：niri-repo.kdl 排在 dms/*.kdl 之前（键位会被 DMS 覆盖）"
        else
            info "需要改动：config.kdl 缺 $own_include"
        fi
    fi
else
    warn "缺仓库片段 $fragment：先运行 install.sh 部署，再运行本脚本"
fi

# 4) 钉钉窗口规则走 DMS 自管通道（仓库 common.kdl 在 DMS 机器上不生效）。
#    顺序要求：通用浮动规则在前，主窗口平铺规则在后（niri 按顺序处理、后者覆盖前者）。
rules=$(dms config windowrules list niri 2>/dev/null || true)
case $rules in
    *'"rules"'*)
        rules_normalized=$(printf '%s\n' "$rules" | sed 's/},{/}\n{/g')

        ensure_window_rule() {
            rule_label=$1
            rule_json=$2
            shift 2

            matches=$rules_normalized
            for marker in "$@"; do
                matches=$(printf '%s\n' "$matches" | grep -F -- "$marker" || true)
                [ -n "$matches" ] || break
            done
            [ -n "$matches" ] && return 0

            drift=1
            if [ "$apply" -eq 1 ]; then
                info "补钉钉窗口规则：$rule_label"
                dms config windowrules add niri "$rule_json" >/dev/null 2>&1 ||
                    warn "添加窗口规则失败：$rule_label"
            else
                info "需要改动：缺钉钉窗口规则「$rule_label」"
            fi
        }

        dingtalk_appid='"appId":"^com\\.alibabainc\\.dingtalk$"'

        ensure_window_rule "弹窗不抢焦点" \
            '{"name":"DingTalk popups keep keyboard focus","matchCriteria":{"appId":"^com\\.alibabainc\\.dingtalk$"},"actions":{"openFocused":false},"enabled":true}' \
            "$dingtalk_appid" '"openFocused":false'

        ensure_window_rule "弹窗默认浮动" \
            '{"name":"DingTalk popups floating","matchCriteria":{"appId":"^com\\.alibabainc\\.dingtalk$"},"actions":{"openFloating":true},"enabled":true}' \
            "$dingtalk_appid" '"openFloating":true'

        ensure_window_rule "主窗口保持平铺" \
            '{"name":"DingTalk main window tiled","matchCriteria":{"appId":"^com\\.alibabainc\\.dingtalk$","title":"^钉钉|钉钉$"},"actions":{"openFloating":false},"enabled":true}' \
            "$dingtalk_appid" '"openFloating":false'
        ;;
    *)
        info "跳过钉钉窗口规则：dms config windowrules 无输出（DMS 版本或会话不支持）"
        ;;
esac

if [ "$drift" -eq 0 ]; then
    info "已是最新，无需改动"
elif [ "$apply" -eq 1 ]; then
    info "完成。验证：niri validate -c $config / dms doctor / dms config windowrules list niri / dms ipc call settings get acLockTimeout"
fi

if [ "$mode" = check ] && [ "$drift" -eq 1 ]; then
    exit 1
fi

exit 0
