#!/bin/sh
# 钉钉排障脚本。日常启动用官方 Elevator.sh（Mod+C / desktop entry）。
# 本脚本只检查 ScreenCast/PipeWire 状态，并精确清理当前用户的钉钉/tblive。

notify_problem() {
    title=$1
    body=$2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$body" || true
    fi
    printf '%s: %s\n' "$title" "$body" >&2
}

is_owned_dingtalk_process() {
    pid=$1
    proc_dir=/proc/$pid
    process_uid=

    [ -r "$proc_dir/status" ] || return 1
    while IFS=: read -r field value; do
        if [ "$field" = Uid ]; then
            set -- $value
            process_uid=${1:-}
            break
        fi
    done < "$proc_dir/status"
    [ "$process_uid" = "$dingtalk_user_uid" ] || return 1

    executable=$(readlink "$proc_dir/exe" 2>/dev/null) || return 1
    case ${executable##*/} in
        com.alibabainc.dingtalk|tblive)
            return 0
            ;;
    esac
    return 1
}

dingtalk_processes_running() {
    for proc_dir in /proc/[0-9]*; do
        pid=${proc_dir##*/}
        if is_owned_dingtalk_process "$pid"; then
            return 0
        fi
    done
    return 1
}

signal_dingtalk_processes() {
    signal=$1
    for proc_dir in /proc/[0-9]*; do
        pid=${proc_dir##*/}
        is_owned_dingtalk_process "$pid" || continue
        case $signal in
            TERM) kill -TERM "$pid" 2>/dev/null || true ;;
            KILL) kill -KILL "$pid" 2>/dev/null || true ;;
        esac
    done
}

require_process_tools() {
    for dep in id readlink; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            notify_problem \
                "DingTalk troubleshooting unavailable" \
                "缺少基础命令 $dep，无法安全检查或清理钉钉。"
            exit 127
        fi
    done
    dingtalk_user_uid=$(id -u)
}

portal_backend_has_screencast() {
    busctl --user introspect \
        org.freedesktop.impl.portal.desktop.gnome \
        /org/freedesktop/portal/desktop 2>/dev/null |
        grep -F 'org.freedesktop.impl.portal.ScreenCast' >/dev/null 2>&1
}

print_status() {
    require_process_tools

    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
        printf 'session: wayland (%s)\n' "${WAYLAND_DISPLAY:-unset}"
    else
        printf 'session: %s\n' "${XDG_SESSION_TYPE:-unknown}"
    fi

    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        if [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] || pgrep -u "$(id -u)" -x pipewire >/dev/null 2>&1; then
            printf 'pipewire: running\n'
        else
            notify_problem \
                "PipeWire is not running" \
                "DingTalk screen sharing needs PipeWire, WirePlumber, and xdg-desktop-portal."
            printf 'pipewire: missing\n'
        fi
    else
        printf 'pipewire: skipped (not a Wayland session)\n'
    fi

    if command -v busctl >/dev/null 2>&1 && [ "${XDG_SESSION_TYPE:-}" = wayland ]; then
        if portal_backend_has_screencast; then
            printf 'screencast portal: ready\n'
        else
            printf 'screencast portal: missing\n'
        fi
    else
        printf 'screencast portal: skipped\n'
    fi

    found=0
    for proc_dir in /proc/[0-9]*; do
        pid=${proc_dir##*/}
        is_owned_dingtalk_process "$pid" || continue
        executable=$(readlink "$proc_dir/exe" 2>/dev/null) || continue
        printf 'process: %s %s\n' "$pid" "${executable##*/}"
        found=1
    done
    if [ "$found" -eq 0 ]; then
        printf 'process: none\n'
    fi
}

stop_dingtalk_processes() {
    require_process_tools
    # 通过 /proc/<pid>/exe 精确匹配可执行文件，避免按完整命令行匹配时把
    # 恰好包含钉钉路径的 shell、测试或诊断工具一起终止。
    # tblive 的 PPID 会在主进程退出后变成 1，因此每轮都重新扫描当前用户的
    # com.alibabainc.dingtalk 与 tblive，而不是依赖父子关系。
    signal_dingtalk_processes TERM
    i=0
    while [ "$i" -lt 5 ]; do
        dingtalk_processes_running || break
        sleep 1
        i=$((i + 1))
    done
    # SIGTERM 5 秒后仍未退出则 SIGKILL 强杀（钉钉作为 Electron 应用常响应慢）
    if dingtalk_processes_running; then
        signal_dingtalk_processes KILL
        sleep 1
    fi
    if dingtalk_processes_running; then
        notify_problem "DingTalk still running" "精确清理后仍有钉钉/tblive 进程。"
        exit 1
    fi
    printf 'DingTalk processes stopped.\n'
}

print_usage() {
    cat <<'EOF'
用法: dingtalk-wayland <子命令>
  status        检查会话、PipeWire、ScreenCast portal 和钉钉进程
  stop|kill     精确清理当前用户的钉钉/tblive
  usage|--help  显示此帮助

日常启动请用 Mod+C 选择钉钉（官方 Elevator.sh）。本脚本只用于排障。
EOF
}

case "${1:-}" in
    usage|--help|-h|"")
        print_usage
        [ -n "${1:-}" ] || exit 2
        exit 0
        ;;
    status)
        print_status
        ;;
    stop|kill)
        stop_dingtalk_processes
        ;;
    *)
        print_usage >&2
        exit 2
        ;;
esac
