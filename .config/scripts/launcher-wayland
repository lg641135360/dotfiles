#!/bin/sh
# Wayland launcher with a conservative fallback for the current Awesome/Rofi setup.

# export GTK_IM_MODULE=fcitx
unset GTK_IM_MODULE
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx
export GLFW_IM_MODULE=ibus
export INPUT_METHOD=fcitx
export LC_CTYPE=${LC_CTYPE:-zh_CN.UTF-8}

# 仅当当前没有「Wayland 连接的 fcitx5」时才启动/接管。fcitx5 走 per-user 的
# D-Bus/socket，fcitx5-remote --check 会命中其它会话（如 Awesome X11）残留的
# 实例，导致 Wayland 应用连到无 WAYLAND_DISPLAY 的旧实例、无法输入中文；用
# /proc/<pid>/environ 判断是否带 WAYLAND_DISPLAY 可正确区分。environ 是 NUL
# 分隔的单行数据，必须 grep -z 逐变量匹配；裸 ^ 只命中首变量，会永久误判为
# 未运行、每次拉起 launcher 都 --replace 重启 fcitx5（托盘图标反复消失）。
fcitx5_wayland_running=0
if command -v pgrep >/dev/null 2>&1; then
    for _fcitx5_pid in $(pgrep -x fcitx5 2>/dev/null); do
        if grep -zaq '^WAYLAND_DISPLAY=' "/proc/$_fcitx5_pid/environ" 2>/dev/null; then
            fcitx5_wayland_running=1
            break
        fi
    done
fi
if command -v fcitx5 >/dev/null 2>&1 && [ "$fcitx5_wayland_running" = "0" ]; then
    fcitx5 -d --replace >/dev/null 2>&1 || true
fi

if command -v fuzzel >/dev/null 2>&1; then
    exec fuzzel "$@"
fi

if [ -x "$HOME/.config/scripts/rofi-launch" ]; then
    exec "$HOME/.config/scripts/rofi-launch" "$@"
fi

if command -v rofi >/dev/null 2>&1; then
    exec rofi -show drun "$@"
fi

if command -v notify-send >/dev/null 2>&1; then
    notify-send "Launcher unavailable" "Install fuzzel or rofi to enable Mod+c in niri." || true
fi

printf '%s\n' 'Launcher unavailable: install fuzzel or rofi.' >&2
exit 127
