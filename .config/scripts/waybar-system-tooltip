#!/bin/sh
# Waybar custom CPU/MEM module: emits JSON with usage and top-5 processes.
#
# Output schema (return-type=json):
#   {"text":"42%","tooltip":"CPU 使用率：42%\n\nTop CPU 进程\n...","percentage":42,"class":"warning"}
#
# CPU usage is a delta between two /proc/stat samples; the first invocation
# after a state-file change reads as 0%. State files live under
# $XDG_STATE_HOME/dotfiles and are keyed per invocation so concurrent waybar
# instances don't clobber each other.
#
# Note: waybar's return-type=json takes tooltip from the JSON field;
# tooltip-exec is ignored in json mode, so we must compute top processes on
# every interval. Interval is set to 5s in the config to keep steady-state
# CPU cost around 2-3%.

set -eu

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles
mkdir -p "$state_dir" 2>/dev/null || true

json_escape() {
    # Escape for JSON string: backslash, double-quote, newline, tab.
    sed -e 's/\\/\\\\/g' \
        -e 's/"/\\"/g' \
        -e ':a' -e 'N' -e '$!ba' -e 's/\n/\\n/g' \
        -e 's/\t/\\t/g'
}

emit_class() {
    # $1 usage (0-100), $2 warning threshold, $3 critical threshold
    usage=$1
    warn=$2
    crit=$3
    if [ "$usage" -ge "$crit" ]; then
        printf 'critical'
    elif [ "$usage" -ge "$warn" ]; then
        printf 'warning'
    else
        printf ''
    fi
}

format_mem_value() {
    # $1 value in KB
    kb=$1
    if [ "$kb" -ge 1048576 ]; then
        awk -v k="$kb" 'BEGIN { printf "%.1fG", k / 1048576 }'
    elif [ "$kb" -ge 1024 ]; then
        awk -v k="$kb" 'BEGIN { printf "%.0fM", k / 1024 }'
    else
        printf '%sK' "$kb"
    fi
}

read_cpu_usage() {
    # /proc/stat first line: cpu user nice system idle iowait irq softirq steal
    # busy = user+nice+system+irq+softirq+steal ; idle = idle+iowait
    state_file="$state_dir/waybar-cpu"
    cur=$(awk '/^cpu /{print $2,$3,$4,$5,$6,$7,$8,$9}' /proc/stat 2>/dev/null || true)
    [ -n "$cur" ] || { echo 0; return; }

    prev=""
    [ -f "$state_file" ] && prev=$(cat "$state_file" 2>/dev/null || true)
    printf '%s\n' "$cur" >"$state_file" 2>/dev/null || true
    [ -n "$prev" ] || { echo 0; return; }

    awk -v cur="$cur" -v prev="$prev" '
        BEGIN {
            n1 = split(cur, c, " ")
            n2 = split(prev, p, " ")
            busy = 0; prev_busy = 0; idle = 0; prev_idle = 0
            for (i = 1; i <= n1 && i <= 8; i++) {
                if (i == 4 || i == 5) {
                    idle += c[i]
                    prev_idle += (i <= n2) ? p[i] : 0
                } else {
                    busy += c[i]
                    prev_busy += (i <= n2) ? p[i] : 0
                }
            }
            total = busy + idle
            prev_total = prev_busy + prev_idle
            delta_total = total - prev_total
            delta_busy = busy - prev_busy
            if (delta_total <= 0) { print 0; exit }
            printf "%d", (delta_busy * 100) / delta_total
        }
    '
}

read_mem_usage() {
    # Outputs: usage_percent used_kb total_kb
    awk '
        /^MemTotal:/      { total = $2 }
        /^MemAvailable:/  { avail = $2 }
        /^MemFree:/       { free = $2 }
        /^Buffers:/       { buffers = $2 }
        /^Cached:/        { cached = $2 }
        END {
            if (total == 0) { print "0 0 0"; exit }
            if (avail == 0) { avail = free + buffers + cached }
            used = total - avail
            if (used < 0) used = 0
            printf "%d %d %d", (used * 100) / total, used, total
        }
    ' /proc/meminfo 2>/dev/null || echo "0 0 0"
}

top_cpu_processes() {
    # %CPU is cumulative since process start, not instantaneous, but it's the
    # cheapest signal for "top consumers". Skip ps/sh noise; awk-limit to 5 to
    # avoid SIGPIPE from head closing the pipe early.
    ps --sort=-pcpu -eo pid,comm,pcpu --no-headers 2>/dev/null \
        | awk '$2 != "ps" && $2 != "sh" { printf "%s  %s  %.0f%%\n", $1, $2, $3; if (++n >= 5) exit }'
}

top_mem_processes() {
    ps --sort=-rss -eo pid,comm,rss --no-headers 2>/dev/null \
        | awk '$2 != "ps" && $2 != "sh" { print; if (++n >= 5) exit }' \
        | while read -r pid comm rss; do
            [ -n "$rss" ] || continue
            printf '%s  %s  %s\n' "$pid" "$comm" "$(format_mem_value "$rss")"
        done
}

emit_cpu() {
    usage=$(read_cpu_usage)
    class=$(emit_class "$usage" 70 90)
    top=$(top_cpu_processes)
    tooltip=$(printf 'CPU 使用率：%s%%\n\nTop CPU 进程\n%s' "$usage" "$top" | json_escape)
    cat <<EOF
{"text":"${usage}%","tooltip":"${tooltip}","percentage":${usage:-0},"class":"${class}"}
EOF
}

emit_mem() {
    set -- $(read_mem_usage)
    usage=$1
    used=$2
    total=$3
    class=$(emit_class "$usage" 80 95)
    top=$(top_mem_processes)
    if [ "$total" -gt 0 ] 2>/dev/null; then
        summary=$(printf '内存使用率：%s%%\n已用：%s / %s' "$usage" "$(format_mem_value "$used")" "$(format_mem_value "$total")")
    else
        summary=$(printf '内存使用率：%s%%' "$usage")
    fi
    tooltip=$(printf '%s\n\nTop 内存进程\n%s' "$summary" "$top" | json_escape)
    cat <<EOF
{"text":"${usage}%","tooltip":"${tooltip}","percentage":${usage:-0},"class":"${class}"}
EOF
}

case "${1:-}" in
    cpu)
        emit_cpu
        ;;
    mem)
        emit_mem
        ;;
    *)
        echo "Usage: $0 {cpu|mem}" >&2
        exit 2
        ;;
esac
