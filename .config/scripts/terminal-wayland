#!/bin/sh
# Wayland terminal entrypoint for niri.

# 默认使用 foot（Wayland 原生终端），alacritty 仅作兜底。
# 2026-08-31 起 niri/Wayland 会话默认终端统一为 foot（含 x86_64），alacritty 仅在
# foot 缺失时回退。历史背景：aarch64 曾因 MediaTek mtgpu 缩放输出下 alacritty
# 0.18.0-dev 字形损坏（内屏 2x 文字丢失）而优先 foot；现全平台统一 foot 优先，
# aarch64 行为不变（详见 logs/trace.md 与 memory/foot.md）。
if command -v foot >/dev/null 2>&1; then
    exec foot "$@"
fi

if command -v alacritty >/dev/null 2>&1; then
    exec alacritty "$@"
fi

if command -v notify-send >/dev/null 2>&1; then
    notify-send "Terminal unavailable" "Install foot or Alacritty to enable Mod+Return in niri." || true
fi

printf '%s\n' 'Terminal unavailable: install foot or Alacritty.' >&2
exit 127
