#!/bin/sh
# Wayland 剪贴板管理入口（wl-clip-persist + cliphist）。
# 无参数：启动 wl-clip-persist 常驻守护，持久化剪贴板（窗口关闭后内容不丢）。
# history：用 fuzzel 弹出剪贴板历史检索，选中项写回剪贴板。
# 缺依赖时提示并退出，不中断会话（与 wayland-autostart 的跳过风格一致）。

warn() {
    printf '[clipboard-wayland] %s\n' "$*" >&2
}

# 剪贴板守护：wl-clip-persist 自身就是常驻守护，直接启动；另用
# wl-paste --watch cliphist store 记录历史。两者由本脚本共同监管，任一异常退出时
# 清理另一进程，让 wayland-autostart 下次启动时可以完整恢复。
start_persist() {
    if ! command -v wl-paste >/dev/null 2>&1; then
        warn "跳过剪贴板守护：未找到命令 wl-paste"
        exit 0
    fi

    persist_pid=
    history_pid=

    cleanup() {
        trap - EXIT INT TERM HUP
        [ -n "$persist_pid" ] && kill "$persist_pid" 2>/dev/null || true
        [ -n "$history_pid" ] && kill "$history_pid" 2>/dev/null || true
        [ -n "$persist_pid" ] && wait "$persist_pid" 2>/dev/null || true
        [ -n "$history_pid" ] && wait "$history_pid" 2>/dev/null || true
    }
    trap cleanup EXIT
    trap 'exit 0' INT TERM HUP

    if command -v wl-clip-persist >/dev/null 2>&1; then
        wl-clip-persist --clipboard regular &
        persist_pid=$!
    else
        warn "剪贴板持久化不可用：未找到命令 wl-clip-persist（Nix: nix profile install nixpkgs#wl-clip-persist）"
    fi

    if command -v cliphist >/dev/null 2>&1; then
        wl-paste --watch cliphist store &
        history_pid=$!
    else
        warn "剪贴板历史记录不可用：未找到命令 cliphist（apt: sudo apt install cliphist）"
    fi

    if [ -z "$persist_pid" ] && [ -z "$history_pid" ]; then
        exit 0
    fi

    while :; do
        if [ -n "$persist_pid" ] && ! kill -0 "$persist_pid" 2>/dev/null; then
            warn "wl-clip-persist 已退出，停止剪贴板守护"
            exit 1
        fi
        if [ -n "$history_pid" ] && ! kill -0 "$history_pid" 2>/dev/null; then
            warn "cliphist 监听已退出，停止剪贴板守护"
            exit 1
        fi
        sleep 5
    done
}

# 剪贴板历史检索：cliphist list → fuzzel 选择 → cliphist decode → wl-copy 写回。
show_history() {
    if ! command -v cliphist >/dev/null 2>&1; then
        warn "剪贴板历史不可用：未找到命令 cliphist（apt: sudo apt install cliphist）"
        exit 1
    fi
    if ! command -v fuzzel >/dev/null 2>&1; then
        warn "剪贴板历史不可用：未找到命令 fuzzel"
        exit 1
    fi
    if ! command -v wl-copy >/dev/null 2>&1; then
        warn "剪贴板历史不可用：未找到命令 wl-copy"
        exit 1
    fi

    # fuzzel 1.12.0（Ubuntu apt）支持 --dmenu + --prompt；勿引入更新版本才有的选项。
    # cliphist list 输出是 <id>\t<content>，decode 后经 wl-copy 写回剪贴板。
    selected=$(cliphist list | fuzzel --dmenu --prompt "剪贴板 >")
    [ -n "$selected" ] || exit 0
    printf '%s\n' "$selected" | cliphist decode | wl-copy
}

case "${1:-}" in
    history)
        show_history
        ;;
    start|"")
        start_persist
        ;;
    *)
        warn "未知子命令：$1（支持：history / start）"
        exit 1
        ;;
esac
